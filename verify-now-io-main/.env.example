# Used by `docker compose` (auto-loaded from repo root). Copy to `.env` and
# fill in real values before running `docker compose up`.
#
# Backend-specific tuning still lives in backend/.env.example if you run the
# backend outside Docker; these are the same variables, just consumed via
# docker-compose's environment substitution here.

# Required for real, non-mock verification. Without this, every request
# will return UNCERTAIN with an explicit "no API key configured" limitation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_WEB_SEARCH_ENABLED=true

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

RATE_LIMIT_PER_MINUTE=20
CACHE_TTL_SECONDS=21600

KAFKA_ENABLED=true

# Optional secondary AI-generated-text signal (HuggingFace model id). Leave
# empty to disable; enabling requires adding transformers/torch to
# backend/requirements.txt.
AI_TEXT_DETECTOR_MODEL=

# Frontend build-time API base URL (must be reachable from the user's browser,
# not just from inside the Docker network).
VITE_API_BASE_URL=http://localhost:8000

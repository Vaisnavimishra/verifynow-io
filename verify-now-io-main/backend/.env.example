# Copy to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

DATABASE_URL=postgresql+asyncpg://verifynow:verifynow@postgres:5432/verifynow

REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=21600
RATE_LIMIT_PER_MINUTE=20

KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_VERIFICATION_TOPIC=verification-tasks
KAFKA_CONSUMER_GROUP=verification-workers

# Required for real verification to run. Without this, all requests return UNCERTAIN.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_WEB_SEARCH_ENABLED=true

# Optional secondary signal, disabled by default.
AI_TEXT_DETECTOR_MODEL=

MAX_UPLOAD_MB=20
